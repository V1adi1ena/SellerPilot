# Copy to .env at the repository root. Never commit .env.
APP_NAME=SellerPilot
DB_HOST=127.0.0.1
# Docker Compose maps host port 3307 to container port 3306.
# For an existing local MySQL installation, use its actual port.
DB_PORT=3307
DB_NAME=sellerpilot
DB_USER=sellerpilot
DB_PASSWORD=
# Needed only when starting MySQL with Docker Compose.
MYSQL_ROOT_PASSWORD=

JWT_SECRET_KEY=
